# Copy to .env.local and replace change-me with a generated random key.
# Load explicitly in Bash: set -a; source .env.local; set +a
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: defaults are false with DEBUG=true, true with DEBUG=false.
# DJANGO_SESSION_COOKIE_SECURE=false
# DJANGO_CSRF_COOKIE_SECURE=false
# DJANGO_SECURE_SSL_REDIRECT=false

# Only enable behind a trusted reverse proxy, such as Render.
DJANGO_TRUST_PROXY_HEADERS=false
# Optional, comma-separated HTTPS origins for the admin (no wildcard).
DJANGO_CSRF_TRUSTED_ORIGINS=
